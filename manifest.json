{
  "manifest_version": 2,
  "name": "Extrator NFCe Nota Paraná",
  "version": "2.3.0",
  "description": "Seleciona notas do Nota Paraná, remove itens não alimentícios e prepara as diárias.",
  "permissions": [
    "storage",
    "https://notaparana.pr.gov.br/*"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fabianofnl@gmail.com"
    }
  },
  "background": {
    "scripts": [
      "src/shared/money.js",
      "src/shared/nfce.js",
      "src/shared/settings.js",
      "src/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Extrator NFCe Nota Paraná",
    "default_icon": {
      "16": "icons/icons8-16.png",
      "32": "icons/icons8-32.png",
      "48": "icons/icons8-48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icons8-16.png",
    "32": "icons/icons8-32.png",
    "48": "icons/icons8-48.png",
    "96": "icons/icons8-96.png"
  },
  "web_accessible_resources": [
    "src/content/panel.css"
  ]
}
